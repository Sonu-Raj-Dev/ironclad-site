---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import about from '../content/about.json';
---
<Base title={about.seoTitle} description={about.seoDescription}>

  <div class="relative bg-void u-grain overflow-hidden">
    <div class="halo" style="width:min(90vw,620px); top:30%" aria-hidden="true"></div>
    <div class="u-wrap relative pt-14 pb-16 md:pt-20 md:pb-20">
      <p class="u-label text-blood">About us</p>
      <h1 class="font-display font-black uppercase mt-5 leading-[0.9] text-[2.75rem] sm:text-6xl lg:text-7xl">
        {about.headingLine1}<br />
        {about.headingLine2.split(about.highlightWord)[0]}<span class="text-blood">{about.highlightWord}</span>{about.headingLine2.split(about.highlightWord)[1]}
      </h1>
      <p class="u-prose mt-7 text-ash md:text-lg">{about.intro}</p>
    </div>
  </div>

  <div class="bg-coal border-y border-edge">
    <div class="u-wrap py-16 md:py-24 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="rv">
        <Photo src={about.storyPhoto} alt="Ironclad in its early days"
               label="Photo — the founders / early days" class="aspect-[5/4] w-full object-cover" />
      </div>
      <div class="rv">
        <p class="u-label text-blood">The short version</p>
        <h2 class="font-display font-extrabold uppercase text-2xl md:text-4xl mt-4 leading-[1.05]">{about.storyHeading}</h2>
        <div class="u-prose mt-5 space-y-4 text-ash">
          {about.story.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>

  <div class="bg-void u-grain relative">
    <div class="u-wrap py-16 md:py-24">
      <h2 class="font-display font-extrabold uppercase text-3xl md:text-5xl rv">{about.principlesHeading}</h2>
      <div class="grid md:grid-cols-3 gap-5 mt-10 stage">
        {about.principles.map((p) => (
          <div class="tilt rv bg-coal border border-edge p-7">
            <div class="tilt__pop">
              <h3 class="font-display font-bold uppercase text-xl">{p.title}</h3>
              <p class="mt-3 text-sm text-ash">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-coal border-y border-edge">
    <div class="u-wrap py-16 md:py-24">
      <p class="u-label text-blood rv">The team</p>
      <h2 class="font-display font-extrabold uppercase text-3xl md:text-5xl mt-4 rv">{about.coachesHeading}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
        {about.coaches.map((c) => (
          <div class="rv group">
            <div class="relative">
              <Photo src={c.photo} alt={c.name} label="Photo — coach portrait"
                     class="aspect-[4/5] w-full object-cover" />
              <div class="absolute inset-x-0 bottom-0 h-1 bg-blood scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500"></div>
            </div>
            <h3 class="font-display font-bold uppercase text-lg mt-4">{c.name}</h3>
            <p class="u-label text-blood mt-1">{c.role}</p>
            <p class="mt-3 text-sm text-ash">{c.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-void u-grain relative">
    <div class="u-wrap py-16 md:py-24 grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16">
      <div class="rv">
        <p class="u-label text-blood">The facility</p>
        <h2 class="font-display font-extrabold uppercase text-2xl md:text-4xl mt-4 leading-[1.05]">{about.facilityHeading}</h2>
        <p class="u-prose mt-5 text-ash">{about.facilityIntro}</p>
      </div>
      <ul class="font-mono text-sm grid sm:grid-cols-2 gap-x-10 border-t border-edge rv list-none p-0 m-0">
        {about.facility.map((f) => (
          <li class="flex justify-between gap-4 py-3 border-b border-edge">
            <span class="text-ash">{f.item}</span><span class="text-blood tnum">{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
